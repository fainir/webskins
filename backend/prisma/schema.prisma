generator client {
  provider = "prisma-client-js"
}

model Metric {
  id String @id @default(cuid())
  skinId String
  kind String
  actor String
  day String
  @@unique([skinId,kind,actor,day])
  @@index([actor,kind,day])
  @@index([day])
}

datasource db {
  // A SQLite file on the service volume: the marketplace is one small table.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Skin {
  id          String   @id @default(cuid())
  name        String
  description String?
  css         String
  domain      String
  prompt      String?
  authorName  String
  authorId    String   // anonymous fingerprint from extension
  manageKeyHash String? // private capability hash; never returned by public reads
  thumbnail   String?
  likes       Int      @default(0)
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@index([likes(sort: Desc)])
  @@index([installs(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
